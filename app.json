{
  "expo": {
    "name": "Adro",
    "slug": "adro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "adro",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "bundleIdentifier": "com.adro.app",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:gymi-inky.vercel.app",
        "applinks:adro.sa"
      ],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.adro.app",
      "adaptiveIcon": {
        "backgroundColor": "#3355FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "gymi-inky.vercel.app",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "adro.sa",
              "pathPrefix": "/i/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.health.READ_EXERCISE",
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_SKIN_TEMPERATURE",
        "android.permission.health.READ_MENSTRUATION",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_ACTIVE_CALORIES_BURNED",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.WRITE_HYDRATION",
        "android.permission.health.WRITE_WEIGHT"
      ],
      "blockedPermissions": []
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Adro",
      "shortName": "Adro",
      "lang": "en",
      "themeColor": "#3355FF",
      "backgroundColor": "#FFFFFF",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3355FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Adro uses the camera to scan food barcodes and take photos of meals, labels and gym machines.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Adro lets you pick a photo of a meal, a label, a lab report or your progress.",
          "cameraPermission": "Adro uses the camera to take photos of meals, labels and gym machines.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3355FF"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Adro uses Face ID to lock your cycle tracking if you turn that on."
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Adro uses the microphone so you can log food, sets and questions by voice.",
          "speechRecognitionPermission": "Adro turns your voice into text to log food, sets and questions.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Adro reads your steps, heart rate, sleep, weight, body fat, breathing, blood oxygen, temperature, cycle and workouts so your coach can adjust your plan.",
          "NSHealthUpdateUsageDescription": "If you turn it on, Adro saves your workouts, meals, water and weight to Apple Health.",
          "background": false
        }
      ],
      "react-native-health-connect",
      "expo-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-asset",
      "expo-background-task",
      [
        "expo-widgets",
        {
          "frequentUpdates": true,
          "widgets": [
            {
              "name": "AdroToday",
              "displayName": "Adro: Today",
              "description": "Calories left, protein and steps for today.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular"
                ]
              }
            },
            {
              "name": "AdroTrain",
              "displayName": "Adro: Training",
              "description": "Today’s workout, the next one and your streak.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Adro connects to your Bluetooth heart rate sensor (a chest strap, or a watch broadcasting heart rate) to show your heart rate live during cardio."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Adro uses your location only during an outdoor cardio session you start, to measure distance and pace, also while your phone is locked.",
          "locationAlwaysAndWhenInUsePermission": "Adro uses your location only during an outdoor cardio session you start, to measure distance and pace, also while your phone is locked.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "80a242f0-4c0c-4457-ab37-7097568977c9"
      }
    },
    "owner": "ahmed.2002",
    "updates": {
      "url": "https://u.expo.dev/80a242f0-4c0c-4457-ab37-7097568977c9"
    }
  }
}
