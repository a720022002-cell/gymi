{
  "expo": {
    "name": "Gymi",
    "slug": "gymi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymi",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "bundleIdentifier": "com.gymi.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gymi.app",
      "adaptiveIcon": {
        "backgroundColor": "#3355FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Gymi",
      "shortName": "Gymi",
      "lang": "en",
      "themeColor": "#3355FF",
      "backgroundColor": "#FFFFFF",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3355FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Gymi uses the camera to scan food barcodes and take photos of meals, labels and gym machines.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gymi lets you pick a photo of a meal, a label, a lab report or your progress.",
          "cameraPermission": "Gymi uses the camera to take photos of meals, labels and gym machines.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3355FF"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Gymi uses Face ID to lock your cycle tracking if you turn that on."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
