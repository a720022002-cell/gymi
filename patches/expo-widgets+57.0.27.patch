+/**
+ * Hands a Live Activity tap to the app's JavaScript. Public so the app can declare the same intent in its own target:
+ * iOS runs a LiveActivityIntent in the app's process only when the app itself declares it.
+ */
+public enum ExpoWidgetsLiveTaps {
+  public static func receive(source: String?, target: String?) async {
+    let event: [String: Any] = [
       "source": source as Any,
       "target": target as Any,
       "timestamp": Int(Date().timeIntervalSince1970 * 1000)
-    ])
+    ]
+    // The app may be asleep: keep the tap until the app's JavaScript takes it (takePendingInteractions), and stay
+    // awake until then, plus a moment for it to update the Live Activity.
+    WidgetsPendingInteractions.add(event)
+    WidgetsEvents.shared.sendNotification(type: .userEvent, data: event)
+    for _ in 0..<50 {
+      if WidgetsPendingInteractions.isEmpty { break }
+      try? await Task.sleep(nanoseconds: 100_000_000)
+    }
+    try? await Task.sleep(nanoseconds: 800_000_000)
+  }
+}
 
-    return .result()
+/** Live Activity taps waiting for the app's JavaScript (kept for a minute at most). */
+enum WidgetsPendingInteractions {
+  private static let lock = NSLock()
+  private static var items: [[String: Any]] = []
+
+  static func add(_ event: [String: Any]) {
+    lock.lock()
+    defer { lock.unlock() }
+    let now = Int(Date().timeIntervalSince1970 * 1000)
+    items = items.filter { now - (($0["timestamp"] as? Int) ?? 0) < 60_000 }
+    items.append(event)
+  }
+
+  static var isEmpty: Bool {
+    lock.lock()
+    defer { lock.unlock() }
+    return items.isEmpty
+  }
+
+  static func take() -> [[String: Any]] {
+    lock.lock()
+    defer { lock.unlock() }
+    let out = items
+    items = []
+    return out
   }
 }
