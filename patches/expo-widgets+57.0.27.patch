+/** Live Activity taps waiting for the app's JavaScript (kept for a minute at most). */
+enum WidgetsPendingInteractions {
+  private static let lock = NSLock()
+  private static var items: [[String: Any]] = []
+
+  static func add(_ event: [String: Any]) {
+    lock.lock()
+    defer { lock.unlock() }
+    let now = Int(Date().timeIntervalSince1970 * 1000)
+    items = items.filter { now - (($0["timestamp"] as? Int) ?? 0) < 60_000 }
+    items.append(event)
+  }
+
+  static var isEmpty: Bool {
+    lock.lock()
+    defer { lock.unlock() }
+    return items.isEmpty
+  }
+
+  static func take() -> [[String: Any]] {
+    lock.lock()
+    defer { lock.unlock() }
+    let out = items
+    items = []
+    return out
