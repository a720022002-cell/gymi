{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npx expo export -p web --clear",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!\\.well-known/).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "adroapp.com"
        }
      ],
      "destination": "/site",
      "permanent": false
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "host",
          "value": "adroapp.com"
        }
      ],
      "destination": "/site/privacy",
      "permanent": false
    },
    {
      "source": "/terms",
      "has": [
        {
          "type": "host",
          "value": "adroapp.com"
        }
      ],
      "destination": "/site/terms",
      "permanent": false
    },
    {
      "source": "/support",
      "has": [
        {
          "type": "host",
          "value": "adroapp.com"
        }
      ],
      "destination": "/site/support",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.adroapp.com"
        }
      ],
      "destination": "https://adroapp.com/:path*",
      "permanent": true
    }
  ]
}
